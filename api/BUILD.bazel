load("@emsdk//emscripten_toolchain:wasm_rules.bzl", "wasm_cc_binary")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")
load("//bazel:force_opt.bzl", "force_opt")
load("//bazel:pick_file.bzl", "pick_file")
load("//bazel:size_limit.bzl", "size_limit")
load("//bazel:wasm_opt.bzl", "wasm_opt")

package(default_visibility = ["//visibility:public"])

# Static/internal cc_library. Name chosen so the implicit libocc_c_lib.so
# output doesn't collide with the cc_shared_library below.
#
# Baseline + literate expansion modules (session, construct, frames, route, …).
cc_library(
    name = "occ_c_lib",
    srcs = [
        "src/occ_c.cc",
        "src/occ_c_session.cc",
        "src/occ_c_construct.cc",
        "src/occ_c_frames.cc",
        "src/occ_c_trsf.cc",
        "src/occ_c_route.cc",
        "src/occ_c_pattern.cc",
        "src/occ_c_hole.cc",
        "src/occ_c_boolean_ext.cc",
        "src/occ_c_query.cc",
        "src/occ_c_sweep_ext.cc",
    ],
    hdrs = [
        "include/occ_c.h",
        "include/occ_c_all.h",
        "include/occ_c_status.h",
        "include/occ_c_session.h",
        "include/occ_c_construct.h",
        "include/occ_c_frames.h",
        "include/occ_c_trsf.h",
        "include/occ_c_route.h",
        "include/occ_c_pattern.h",
        "include/occ_c_hole.h",
        "include/occ_c_boolean_ext.h",
        "include/occ_c_query.h",
        "include/occ_c_sweep_ext.h",
    ],
    # Private shared glue for all occ_c*.cc TUs (not installed).
    textual_hdrs = [
        "src/occ_c_internal.hxx",
    ],
    includes = ["include", "src"],
    deps = ["@occt//:occt"],
    copts = [
        "-Wno-deprecated-declarations",
        "-Wno-unused-variable",
        "-Wno-unused-parameter",
    ],
)

# Convenience alias for callers that want the static library.
alias(
    name = "occ_c",
    actual = ":occ_c_lib",
)

# Single shared artifact for native FFI / language bindings. Statically embeds
# all of @occt//:occt. Only occ_* symbols are exported (project-wide
# -fvisibility=hidden + __attribute__((visibility("default"))) on the API).
cc_shared_library(
    name = "libocc_c",
    shared_lib_name = "libocc_c.so",
    deps = [":occ_c_lib"],
)

# ---------------------------------------------------------------------------
# Browser / Wasm product (Emscripten via @emsdk) — always RELEASE size pipeline
# ---------------------------------------------------------------------------
#
# Pipeline (AgentOS-style):
#   1. force_opt  → compilation_mode=opt on the whole Wasm subgraph
#   2. emcc -Os   → size-oriented compile/link (assertions off)
#   3. wasm_opt   → Binaryen -Oz --converge post-link
#   4. size_limit → CI fails if the .wasm exceeds the budget
#
# Build:
#   bazel build //api:libocc_c_wasm
#   bb build --config=buildbuddy //api:libocc_c_wasm
#
# Shipping outputs: libocc_c.js + libocc_c.wasm (optimized).
# Tagged manual: OCCT+emcc is heavy; keep out of bare `//...`.

# Keep in sync with OCC_API symbols in include/occ_c.h (C names need a
# leading underscore for Emscripten). malloc/free let JS allocate for paths.
_OCC_C_EXPORTS = ",".join([
    "_malloc",
    "_free",
    "_occ_version",
    "_occ_last_error",
    "_occ_shape_free",
    "_occ_shape_copy",
    "_occ_shape_is_null",
    "_occ_make_box",
    "_occ_make_cylinder",
    "_occ_make_sphere",
    "_occ_make_cone",
    "_occ_make_torus",
    "_occ_make_wedge",
    "_occ_fuse",
    "_occ_cut",
    "_occ_intersect",
    "_occ_section",
    "_occ_fillet_all",
    "_occ_fillet_edges",
    "_occ_chamfer_all",
    "_occ_chamfer_edges",
    "_occ_shell",
    "_occ_offset_3d",
    "_occ_extrude",
    "_occ_revolve",
    "_occ_loft",
    "_occ_pipe",
    "_occ_translate",
    "_occ_rotate",
    "_occ_scale",
    "_occ_mirror",
    "_occ_volume",
    "_occ_surface_area",
    "_occ_center_of_mass",
    "_occ_bbox",
    "_occ_count_faces",
    "_occ_count_edges",
    "_occ_count_vertices",
    "_occ_face_at",
    "_occ_edge_at",
    "_occ_vertex_xyz",
    "_occ_step_write",
    "_occ_step_read",
    "_occ_brep_write",
    "_occ_brep_read",
    "_occ_stl_write",
    "_occ_gltf_write",
    "_occ_obj_write",
    "_occ_obj_read",
    "_occ_mesh_compute",
    "_occ_mesh_vertex_count",
    "_occ_mesh_index_count",
    "_occ_mesh_vertices",
    "_occ_mesh_normals",
    "_occ_mesh_indices",
    "_occ_mesh_free",
])

# Size-first Emscripten link (maps AgentOS -Copt-level=z / strip / no-assert).
# Exceptions stay on: OCCT + occ_c catch at the FFI boundary (unlike panic=abort).
# Fat LTO is intentionally omitted here — Binaryen post-link carries whole-module
# DCE without multi-hour OCCT LTO; enable -flto separately if needed.
_WASM_SIZE_COPTS = [
    "-Os",
    "-DNDEBUG",
]

_WASM_LINKOPTS = [
    "-Os",
    "--no-entry",
    "-sMODULARIZE=1",
    "-sEXPORT_ES6=1",
    "-sEXPORT_NAME=createOccModule",
    "-sENVIRONMENT=web,worker,node",
    "-sALLOW_MEMORY_GROWTH=1",
    "-sASSERTIONS=0",
    "-sSTACK_OVERFLOW_CHECK=0",
    # OCCT + occ_c catch C++ exceptions at the FFI boundary.
    "-fexceptions",
    "-sDISABLE_EXCEPTION_CATCHING=0",
    # STEP/BREP path IO uses libc filesystem (MEMFS in the browser).
    "-sFILESYSTEM=1",
    "-sEXPORTED_FUNCTIONS=[%s]" % _OCC_C_EXPORTS,
    # FS exported so JS can read MEMFS paths after STEP/BREP write (smoke/tests).
    "-sEXPORTED_RUNTIME_METHODS=['ccall','cwrap','UTF8ToString','stringToUTF8','lengthBytesUTF8','getValue','setValue','HEAPU8','HEAP8','HEAP16','HEAP32','HEAPF32','HEAPF64','FS']",
]

cc_binary(
    name = "libocc_c_wasm_bin",
    srcs = ["wasm_stub.c"],
    deps = [":occ_c_lib"],
    copts = _WASM_SIZE_COPTS,
    linkopts = _WASM_LINKOPTS,
    tags = ["manual"],
)

# Emscripten package (js + wasm). Always built under -c opt via force_opt below.
wasm_cc_binary(
    name = "libocc_c_wasm_emcc",
    cc_target = ":libocc_c_wasm_bin",
    outputs = [
        "libocc_c_emcc.js",
        "libocc_c_emcc.wasm",
    ],
    tags = ["manual"],
)

# Always release: ignore the top-level -c and force opt on the Wasm subgraph.
force_opt(
    name = "libocc_c_wasm_emcc_release",
    target = ":libocc_c_wasm_emcc",
    tags = ["manual"],
)

pick_file(
    name = "libocc_c_emcc_js",
    src = ":libocc_c_wasm_emcc_release",
    extension = ".js",
    out = "libocc_c.js",
    tags = ["manual"],
)

pick_file(
    name = "libocc_c_emcc_wasm",
    src = ":libocc_c_wasm_emcc_release",
    extension = ".wasm",
    out = "libocc_c_emcc_raw.wasm",
    tags = ["manual"],
)

# Binaryen post-link size pass (AgentOS -Oz --converge).
# Output file: libocc_c_opt.wasm (renamed for shipping via genrule below).
wasm_opt(
    name = "libocc_c_opt",
    wasm = ":libocc_c_emcc_wasm",
    tags = ["manual"],
)

# Stable shipping name expected by docs and smoke scripts.
genrule(
    name = "libocc_c_wasm_file",
    srcs = [":libocc_c_opt"],
    outs = ["libocc_c.wasm"],
    cmd = "cp $< $@",
    tags = ["manual"],
)

# Product alias: JS glue + optimized Wasm.
filegroup(
    name = "libocc_c_wasm",
    srcs = [
        ":libocc_c_emcc_js",  # libocc_c.js
        ":libocc_c_wasm_file",  # libocc_c.wasm
    ],
    tags = ["manual"],
)

# Hard ceiling after the full size pipeline (unoptimized was ~44 MiB).
# Tighten deliberately as the subset / exports shrink.
size_limit(
    name = "libocc_c_wasm_size_limit",
    file = ":libocc_c_wasm_file",
    max_bytes = 32 * 1024 * 1024,  # 32 MiB
    tags = ["manual"],
)

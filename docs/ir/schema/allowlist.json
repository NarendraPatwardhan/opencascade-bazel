{
  "ir_schema": "cad.ir/v0",
  "cad_ir_version": "0.1.0",
  "notes": "Machine-readable allowlist for cad.ir/v0. Authoritative narrative: docs/cad-ir-v0-design.md. Luau cad.ir.validate is product validator (K21). Keep in sync with agent-os/src/batteries/ir/registry.luau OPS (registry is runtime source of truth for known ops).",
  "document": {
    "required": ["ir_schema", "version", "units", "params", "ops", "meta"],
    "optional": ["id", "catalog", "frames", "assembly", "results"],
    "ir_schema_value": "cad.ir/v0",
    "units": {
      "required": ["length", "angle", "store"],
      "length": "meter",
      "angle": "radian",
      "store": "SI"
    },
    "op_id_pattern": "^[A-Za-z_][A-Za-z0-9_./-]*$"
  },
  "limits_default": {
    "max_ops": 4096,
    "route_nodes": 512,
    "pattern_count": 256,
    "max_params": 2048,
    "max_ref_depth": 16,
    "max_chain_joints": 64,
    "max_bool_tools": 64,
    "max_linear_m": 1000,
    "deflection_min": 1e-4,
    "deflection_max": 1.0,
    "wall_clock_ms": 120000,
    "per_op_ms": 30000,
    "max_json_bytes": 2097152,
    "notes": "wall/per-op are cooperative (cannot interrupt mid-cad.call); deflection_min is a security floor (guest cannot lower)"
  },
  "freestanding_selectors": [
    "body",
    "created_by+entity:body",
    "created_by+entity:wire",
    "op (geometry or chain measure)",
    "frame",
    "array of refs",
    "nth"
  ],
  "illegal_freestanding": [
    "entity:face",
    "entity:edge",
    "filters",
    "topology set-ops",
    "all_solids",
    "portable face_index"
  ],
  "tier_a": {
    "description": "v0-demo-required ops (dual-goal demos + box-cut); registered and host-ready",
    "ops": {
      "PrimBox": { "host": "make_box", "binds": "shape", "tier": "A", "registered": true },
      "PrimCylinder": { "host": "make_cylinder", "binds": "shape", "tier": "A", "registered": true },
      "BoolCombine": {
        "host": { "union": "fuse", "subtract": "cut", "intersect": "intersect" },
        "binds": "shape",
        "tier": "A",
        "registered": true
      },
      "Translate": { "host": "translate", "binds": "shape", "tier": "A", "registered": true },
      "Rotate": { "host": "rotate", "binds": "shape", "tier": "A", "registered": true },
      "RigidXform": { "host": "trsf_apply", "binds": "shape", "tier": "A", "registered": true },
      "RoutePath": {
        "host": { "polyline": "make_route", "polyline_bend": "make_route_bends" },
        "binds": "shape",
        "tier": "A",
        "registered": true
      },
      "SweepAlong": {
        "host": "pipe_annulus",
        "binds": "shape",
        "profile_kind_v0": "annulus",
        "tier": "A",
        "registered": true
      },
      "AttachFrame": {
        "host": null,
        "pure_pod": true,
        "binds": "frame",
        "tier": "A",
        "registered": true
      },
      "ComposeChain": {
        "host": "compose_chain",
        "binds": "measure",
        "tier": "A",
        "registered": true
      },
      "QueryClash": {
        "host": { "clash": "clash", "distance": "distance" },
        "binds": "measure",
        "tier": "A",
        "registered": true
      },
      "QueryGeom": {
        "host": { "volume": "volume", "bbox": "bbox" },
        "binds": "measure",
        "tier": "A",
        "registered": true
      },
      "ExportMesh": {
        "host": "mesh_stats",
        "binds": "measure",
        "tier": "A",
        "registered": true,
        "notes": "stats-only; no full mesh arrays over host tool JSON"
      }
    }
  },
  "tier_b": {
    "description": "Registered ops (solid/route/frames/query tape + features). bridge-need entries are aspirational only.",
    "ops": {
